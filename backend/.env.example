SMS_PROVIDER=console
TEXTBELT_KEY=your-textbelt-key
NOTIFY_OVERRIDE_SMS=+15555550123
ADMIN_ACCOUNT=admin@example.com
ADMIN_PASSWORD=your-admin-password
XAI_API_KEY=
# 32 or more characters. Required to save a user's AI API key.
AI_KEY_ENCRYPTION_SECRET=
# Activity files. The server default is /opt/wandervibe/uploads. Set this for local development.
UPLOAD_DIR=
# Stripe Checkout for fixed AI credit packs and membership subscriptions.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Monthly membership prices and one-time credit packs.
STRIPE_PRICE_PLANITVIBE_MONTHLY=
STRIPE_PRICE_PLANITVIBE_PLUS_MONTHLY=
STRIPE_PRICE_PLANITVIBE_PRO_MONTHLY=
STRIPE_PRICE_PLANITVIBE_CREDITS_100=
STRIPE_PRICE_PLANITVIBE_CREDITS_500=
# Optional Checkout return pages. Defaults are the planitvibe.com success and cancel URLs.
STRIPE_SUCCESS_URL=
STRIPE_CANCEL_URL=
# Cloudflare Turnstile secret for POST /api/auth/register. A missing secret returns 503.
TURNSTILE_SECRET_KEY=
# Signup invitations for addresses on the allowed-email list.
# automatic sends when an address is added. manual waits for Send invites.
# The admin site stores the chosen mode, and that choice applies on the next
# request without a restart. This variable is the default until an admin saves
# a mode. Changing this variable needs one API restart, and it applies only
# when no admin has saved a mode.
SIGNUP_INVITE_MODE=manual
# Full signup page URL. The invitation adds ?email= when this URL has no query.
SIGNUP_URL=https://planitvibe.com/signup
# From address for signup invitations. Falls back to EMAIL_FROM.
EMAIL_ACCOUNTS=
